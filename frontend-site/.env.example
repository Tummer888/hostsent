# 后端地址，留空则 BFF 返回内置默认配置（可脱离后端开发）
NUXT_PUBLIC_API_BASE=

# 站点展示时区（活动时间窗按此时区展示）
NUXT_PUBLIC_SITE_TIMEZONE=Asia/Shanghai

# 用户控制台地址（frontend-user）；留空则产品详情页不展示购买入口
NUXT_PUBLIC_CONSOLE_URL=

# 站点对外域名；留空则 robots.txt / sitemap.xml 回落到请求头 origin
NUXT_PUBLIC_SITE_URL=

# 内部缓存失效接口（POST /api/internal/revalidate）的密钥，部署时随机生成。
# 后端 configs/config.yaml 的 revalidate.token 必须与本项一致；留空则接口一律返回 503
# （即「不启用主动失效」，门户仍按 SWR TTL 自然刷新，不会变成无鉴权端点）。
NUXT_INTERNAL_TOKEN=
